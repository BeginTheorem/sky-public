# Runtime configuration for the isolated deployment host.
# Copy this file, replace every placeholder below, and keep the result secret
# (mode 600). "REPLACE_ME" marks a key to fill in; "123456789" marks a numeric
# Telegram ID to fill in. Never commit real values.
# Provider chain: paid openrouter primary, free NVIDIA NIM as the backup,
# free Z.AI GLM flash rungs next, ollama_gemma last. Each rung is one
# (endpoint, model) pair and named for the model it carries. Money-boost gates
# only the paid rungs.
# The backup paid rung has a flag of its own (checked before the shared OPENROUTER_ENABLED)
# because a model the key does not carry answers 403, and 403 classifies as `auth`, which
# fallback._is_fatal treats as chain-fatal -- one mis-keyed rung would kill every call.
# Both models answer on the current key (measured 2026-10-16), so the backup is armed.
SKYNET_PROVIDER_CHAIN=
SKYNET_MONEY_BOOST=
SKYNET_PROVIDER_STATE=

# --- openrouter_deepseek / openrouter_glm (paid) ---
OPENROUTER_ENABLED=
OPENROUTER_GLM_ENABLED=
OPENROUTER_BASE_URL=
OPENROUTER_MODEL=
OPENROUTER_GLM_MODEL=
# Connect/first-byte timeout (short: a stuck connect should fail fast).
OPENROUTER_TIMEOUT_SECONDS=
# Idle/hang timeout: fires only on silence, so a long *active* reasoning stream
# is never cut off. 900s = 15 minutes.
OPENROUTER_CHUNK_TIMEOUT_SECONDS=
# Optional overall stream cap; 0/off by default so total stream time is not
# bounded while chunks keep arriving.
OPENROUTER_STREAM_DEADLINE_SECONDS=
OPENROUTER_MAX_ATTEMPTS=
OPENROUTER_RETRY_DELAY_SECONDS=
# Enable only when a paid OpenRouter key is explicitly configured.
OPENROUTER_API_KEY=REPLACE_ME

# --- ollama_gemma (last rung) ---
OLLAMA_GEMMA_ENABLED=
OLLAMA_BASE_URL=
OLLAMA_MODEL=
# Comma-separated only for a simple deployment. Keep this file secret (mode 600).
OLLAMA_API_KEYS=REPLACE_ME
OLLAMA_KEY_COOLDOWN_SECONDS=
OLLAMA_MAX_ATTEMPTS=

# --- NVIDIA NIM rungs (free backup) ---
NVIDIA_BASE_URL=
NVIDIA_API_KEY=REPLACE_ME
NVIDIA_TIMEOUT_SECONDS=
NVIDIA_MAX_OUTPUT_TOKENS=
# Legacy alias kept off: the canonical per-rung flags below decide.
NVIDIA_ENABLED=
# nvidia_deepseek: NIM lists deepseek-ai/deepseek-v4.1-flash (the renamed id)
# but serves no bytes on the streaming or the non-streaming path (measured
# 2026-09-26), so this rung is normally disabled in the live env.
NVIDIA_DEEPSEEK_ENABLED=
DEEPSEEK_ENABLED=
DEEPSEEK_BASE_URL=
DEEPSEEK_API_KEY=REPLACE_ME
DEEPSEEK_MODEL=
DEEPSEEK_TIMEOUT_SECONDS=
DEEPSEEK_MAX_OUTPUT_TOKENS=
DEEPSEEK_RATE_LIMIT_COOLDOWN_SECONDS=
DEEPSEEK_SERVER_COOLDOWN_SECONDS=
DEEPSEEK_NETWORK_COOLDOWN_SECONDS=
# nvidia_deepseek / nvidia_super / nvidia_ultra / nvidia_lightning: the four NIM
# rungs, in the owner's rotation order (2026-10-17). The chain names them by the
# model they carry; the long ``nvidia_nemotron_*`` names stay accepted as aliases.
NEMOTRON_ULTRA_ENABLED=
NEMOTRON_ULTRA_MODEL=
NEMOTRON_ULTRA_TIMEOUT_SECONDS=
NEMOTRON_ULTRA_MAX_OUTPUT_TOKENS=
# 30B A3B Mamba-2/MoE hybrid, 1M context, fast (measured 0.7-2.9s on text).
# A reasoning model: thinking goes to ``reasoning_content``, and on a tools
# turn it can spend the output budget thinking before it emits the call, which
# the retryable empty-length guard absorbs.
NEMOTRON_LIGHTNING_ENABLED=
NEMOTRON_LIGHTNING_MODEL=
NEMOTRON_LIGHTNING_TIMEOUT_SECONDS=
NEMOTRON_LIGHTNING_MAX_OUTPUT_TOKENS=
# Armed again 2026-10-17: NVIDIA renamed the served model to
# ``nemotron-3.5-super-vl-120b-a12b`` and it answers (3/3 live completions,
# 0.7-11s) while ``ultra`` was answering HTTP 503 "Service temporarily
# overloaded". The old ``nvidia/nemotron-3-super-120b-a12b`` is gone from the
# catalog, which is why this rung was parked as retired before.
NEMOTRON_SUPER_ENABLED=
NEMOTRON_SUPER_MODEL=
NEMOTRON_SUPER_TIMEOUT_SECONDS=
NEMOTRON_SUPER_MAX_OUTPUT_TOKENS=
# Meta 29.6B multimodal reasoning/tool-calling model on NIM; no images are sent,
# it is carried for text reasoning and tool calls. Tail of the chain.
MUSE_GLIMMER_ENABLED=
MUSE_GLIMMER_MODEL=
MUSE_GLIMMER_TIMEOUT_SECONDS=
MUSE_GLIMMER_MAX_OUTPUT_TOKENS=
# Leave these empty to route through the host VPN (default route). A proxy URL
# is only needed to pin an explicit proxy endpoint.
DEEPSEEK_PROXY_URL=
NEMOTRON_ULTRA_PROXY_URL=
NEMOTRON_LIGHTNING_PROXY_URL=
NEMOTRON_SUPER_PROXY_URL=
MUSE_GLIMMER_PROXY_URL=
NVIDIA_PROXY_URL=

# --- Z.AI free rungs (glm-4.7-flash / glm-4.5-flash) ---
# Both models are permanently free (no card). Each exposes a 200K context with
# a 131072 max_tokens ceiling, and the free tier permits ONE concurrent request.
# Real RPM/TPM are not published: they live in the console behind login
# (z.ai/manage-apikey/rate-limits). Thinking is on by default and is disabled
# here, because it is billed to the same output budget and a no-tools turn would
# otherwise end at the ceiling with empty content; ZAI_THINKING=true sends no
# field and restores the endpoint default.
ZAI_ENABLED=
ZAI_BASE_URL=
ZAI_API_KEY=REPLACE_ME
ZAI_MODEL=
ZAI_GLM45_MODEL=
# Free-tier latency measured up to ~167s on a ~190k-token prompt.
ZAI_TIMEOUT_SECONDS=
ZAI_THINKING=
# 429 is Z.AI code 1305; a measured burst blocked for ~50-70s.
ZAI_RATE_LIMIT_COOLDOWN_SECONDS=
# Empty = the host VPN's default route (same convention as the NIM rungs).
ZAI_PROXY_URL=

# --- Mistral free rungs (labs-leanstral-1-5 / codestral-latest) ---
# The free tier grants access PER MODEL: the current flagships (mistral-small-4,
# mistral-medium-3.5) answer 429 with ``x-ratelimit-limit-req-minute: 0``, while
# the two rungs below are served. Measured 2026-09-27: leanstral 38 req/min and
# 5M tok/min, codestral 125 req/min and 625k tok/min, both with 256K context,
# working tools/streaming, no single-concurrent limit, and ``max_tokens=131072``
# accepted without a ceiling error (13893 completion tokens served). leanstral
# rejects a sampling temperature, so no temperature is sent and no proxy is used.
# ``mistral-code-latest`` is the same model as ``codestral-latest`` (both ids
# resolve to codestral-2508), so a single rung carries it.
MISTRAL_ENABLED=
MISTRAL_BASE_URL=
MISTRAL_API_KEY=REPLACE_ME
MISTRAL_LEANSTRAL_MODEL=
MISTRAL_CODESTRAL_MODEL=
MISTRAL_TIMEOUT_SECONDS=
# A per-minute 429 carries no Retry-After, so the rung brakes itself.
MISTRAL_RATE_LIMIT_COOLDOWN_SECONDS=
SKYNET_STATE=
SKYNET_DISPLAY_TIMEZONE=
TZ=
SKYNET_MONEY_BOOST_STATE=
SKYNET_BASH_CWD=
SKYNET_MAX_STEPS=
SKYNET_REACT_INPUT_TOKENS=
# SKYNET_REACT_INPUT_TOKENS is the maximum estimated input context for each provider request.
# The estimate is conservative, so real tokens stay below it; 150k keeps every
# request inside the free Z.AI rungs' 200K context. Session history is durable
# and may be arbitrarily long; only the current payload is bounded.
SKYNET_MEMORY_INPUT_TOKENS=
# The Memory Loop runs after Finish, outside the ReAct budget. It degrades to an
# empty consolidation if the provider is silent longer than this; widen it if
# `memory_degraded` events show up in the durable log.
SKYNET_MEMORY_LOOP_TIMEOUT=
SKYNET_OUTPUT_TOKENS=
# The autonomous planner's own output ceiling, separate from the ReAct cap: a
# 4096 cap let the provider's reasoning channel consume the whole budget and the
# reply carried no content, so decoding failed. Raised with SKYNET_OUTPUT_TOKENS.
SKYNET_PLANNER_OUTPUT_TOKENS=
# One session is two hours of model time (watchdog a little longer).
SKYNET_MAX_SECONDS=
# Mid-run progress: a two-hour run otherwise leaves the owner channel silent
# until Finish. Emit one short factual note to the owner per this interval of
# MODEL time (0 disables). Capped at SKYNET_MAX_SECONDS / interval per run and
# stopped once the Finish phase begins. Read in skynet/cli.py.
SKYNET_RUN_PROGRESS_SECONDS=
# Reserve kept free at the top of the context, and the per-tool-result cap.
SKYNET_CONTEXT_FINISH_RESERVE=
SKYNET_TOOL_RESULT_MAX_CHARS=
SKYNET_MCP_TIMEOUT=
# tools/call gets a longer budget: Playwright and arXiv routinely exceed 30s.
SKYNET_MCP_TOOL_TIMEOUT=
# MCP sensor commands. Paths must be absolute: systemd's PATH does not include
# ~/.local/bin. Replace __HOME__ with the deploy account's home directory
# (systemd does not expand ~ or $HOME in an EnvironmentFile).
SKYNET_MCP_DDG_COMMAND=
# Owner decision 2026-10-16: the Playwright sensor stays installed but parked. `=1` skips it
# in mcp.configured_servers without touching the command; the card then counts three sensors
# instead of reporting a missing one.
SKYNET_MCP_PLAYWRIGHT_COMMAND=
SKYNET_MCP_PLAYWRIGHT_DISABLED=
SKYNET_MCP_ARXIV_COMMAND=
# okama: the Moscow Exchange market layer (owner decision 2026-11-05). Installed with pipx
# from ~/okama-mcp, outside this repository, so the project venv never carries pandas/scipy.
# Tools: portfolio, asset_stats, macro, search — the Russian defaults live in the sensor.
SKYNET_MCP_OKAMA_COMMAND=
# GitHub is read-only, and limited to the toolsets actually used: --read-only
# drops every write tool, and pull_requests/users/orgs had zero calls.
SKYNET_MCP_GITHUB_COMMAND=
# Read by the GitHub MCP server process (not by skynet itself); systemd passes
# this EnvironmentFile to the child, so the token must live here.
GITHUB_PERSONAL_ACCESS_TOKEN=REPLACE_ME
# Provider resilience -- the patient chain (ReAct path). A failing model call is
# retried in place instead of ending the run: each provider gets
# SKYNET_PROVIDER_ATTEMPTS_PER_PROVIDER grouped strikes separated by the
# escalating SKYNET_PROVIDER_ATTEMPT_WAITS; after its last failure it is locked
# for SKYNET_PROVIDER_BLOCK_SECONDS (unless the provider stated its own, shorter
# cooldown); the whole chain is re-passed once the earliest lock expires, and
# only SKYNET_PROVIDER_DEAD_PASSES consecutive whole-chain failures end the run
# (the reactor then sleeps SKYNET_PROVIDER_LOCKOUT_SECONDS). Provider-failure
# time is not charged to the run's model-second budget.
SKYNET_PROVIDER_ATTEMPTS_PER_PROVIDER=
SKYNET_PROVIDER_ATTEMPT_WAITS=
SKYNET_PROVIDER_BLOCK_SECONDS=
SKYNET_PROVIDER_DEAD_PASSES=
# A non-streaming rung can only be bounded by the whole wait (it thinks silently
# and then sends everything at once); a streaming rung by silence between
# chunks. The deadline is the hard cap for one call in which every provider
# hangs silently.
SKYNET_PROVIDER_ATTEMPT_TIMEOUT=
SKYNET_PROVIDER_STREAM_IDLE=
SKYNET_PROVIDER_CALL_DEADLINE=
# Optional cap on how many chain entries the ladder may touch (unset = all).
# Set it only to shorten a long chain on purpose.
# SKYNET_PROVIDER_MAX_ATTEMPTS=8
SKYNET_PROVIDER_LOCKOUT_THRESHOLD=
SKYNET_PROVIDER_LOCKOUT_SECONDS=
# Liveness and observability.
SKYNET_LIVELOCK_STREAK_LIMIT=
SKYNET_PINNED_MEMORY_LIMIT=
# Planning: exploration is what makes the ranking evaluable, a terminal
# hypothesis stops suppressing novelty after the TTL, and the model may propose
# at most one new goal per planning attempt.
SKYNET_PLANNER_EPSILON=
SKYNET_HYPOTHESIS_TTL_DAYS=
SKYNET_MAX_ACTIVE_GOALS=
# The generic bootstrap diagnostic may be re-created only once per this many
# generations; the last creation generation is read from the durable event log.
SKYNET_FALLBACK_REPEAT_GENERATIONS=
# Judge health: a planner that stops reaching a decision (parse failure or
# provider outage) is escalated to the owner instead of silently returning an
# empty portfolio. Read in skynet/reactor.py.
SKYNET_JUDGE_HEALTH_WINDOW=
SKYNET_JUDGE_HEALTH_MIN_SAMPLES=
SKYNET_JUDGE_HEALTH_THRESHOLD=
SKYNET_JUDGE_HEALTH_COOLDOWN_SECONDS=
# Quality-diversity: an empty idea-archive cell outranks a crowded one.
SKYNET_CELL_SCARCITY_WEIGHT=
# Owner-directed outward bias: a curated outward ("roadmap") task sits at goal
# priority 1.0, so on criticality alone it never beats a 4.0 harness goal. This
# lifts it back into contention while staying below the criticality weight, so
# the organism works on the world too, not only on its own skeleton. 0 disables.
SKYNET_OUTWARD_WEIGHT=
# Opening the boundary: when internal work is exhausted, consult an external
# sense before sleeping. Cadence is in generations; the cooldown is durable.
SKYNET_EXTERNAL_SEEK=
SKYNET_EXTERNAL_SEEK_EVERY=
SKYNET_EXTERNAL_SEEK_COOLDOWN=
SKYNET_ARCHIVE_PARENT_K=
SKYNET_ARCHIVE_PARENT_LAMBDA=
SKYNET_ARCHIVE_PARENT_ALPHA0=
# Retention: routine events are pruned daily, safety kinds are never pruned.
SKYNET_EVENT_RETENTION_DAYS=
# Retention for the capability_effects ledger; a row still referenced by a
# retained tool_result event or a retained react_history transcript is pinned.
SKYNET_EFFECT_RETENTION_DAYS=
# The self-improvement gate runs the whole suite; raise this on a slow host.
SKYNET_GATE_TIMEOUT=
# Self-improvement worktrees: a warned proposal holds its worktree only until the
# identical resubmission; the oldest warnings are reclaimed at the cap and a
# warning expires after this many hours, so warnings never wedge the quota.
SKYNET_MAX_WORKTREES=
SKYNET_WARNED_TTL_HOURS=
SKYNET_METRICS_SNAPSHOT=
SKYNET_TASK_GIVEUP_FAILURES=
SKYNET_RESTART_FAILURE_LIMIT=
SKYNET_WATCHDOG_SECONDS=
# Owner channel: the telegram process drains the outbox; a message that keeps
# failing is dead-lettered after the attempt cap instead of retrying forever.
SKYNET_OUTBOX_ENABLED=
SKYNET_OUTBOX_BATCH=
SKYNET_OUTBOX_MAX_ATTEMPTS=
SKYNET_OUTBOX_BACKLOG_LIMIT=
SKYNET_ALERT_TIMEOUT=
# Workspace boundary for bash. Unset defaults to the repository root; set
# SKYNET_SANDBOX_WORKSPACE_DISABLED=1 to turn the containment check off (the
# project is allow-all by design, so this is documentation, not a sandbox).
# SKYNET_SANDBOX_WORKSPACE=.
# SKYNET_SANDBOX_WORKSPACE_DISABLED=1
SKYNET_WEBFETCH_DEADLINE=
# Private Telegram control channel. Keep the token secret and use numeric IDs.
SKYNET_TELEGRAM_BOT_TOKEN=123456789:REPLACE_ME
SKYNET_TELEGRAM_ALLOWED_USER_ID=123456789
SKYNET_TELEGRAM_ALLOWED_CHAT_ID=123456789
# Empty = the host VPN's default route; set a proxy URL only to pin one.
SKYNET_TELEGRAM_PROXY=

# Root access (owner decision 2026-10-15): this account holds NOPASSWD sudo, and the gate
# in skynet/sudo_gate.py is what asks the owner in Telegram before anything privileged runs.
# Reading the logs is pre-approved; destructive commands are refused outright; silence in
# the window below is a refusal, never permission.
SKYNET_SUDO_ENABLED=
SKYNET_SUDO_APPROVAL_TIMEOUT=
# Comma-separated overrides; empty = the built-in log-reading allowlist (journalctl, dmesg, /var/log).
SKYNET_SUDO_ALLOWLIST=
# Comma-separated overrides; empty = the built-in floor list (disk writes, log vacuum, sudoers edits).
SKYNET_SUDO_DENY=

# Automatic session logs in the owner's Telegram (owner decision 2026-10-15): off.
# Finished runs and mid-run progress notes are NOT pushed; the record stays durable and
# /logs renders it on demand. Alerts, questions and whatever the organism says itself
# (send_message_to_user) still arrive. Set to 1 to bring the automatic flow back.
SKYNET_RUN_LOGS_TO_TELEGRAM=
