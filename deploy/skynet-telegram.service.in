[Unit]
Description=SkyNet private Telegram control bot
After=network-online.target tor.service
Wants=network-online.target
OnFailure=skynet-alert@%n.service
StartLimitIntervalSec=900
StartLimitBurst=5

[Service]
Type=simple
User=root
WorkingDirectory=@ROOT@
EnvironmentFile=@ROOT@/config/skynet.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=TZ=UTC
ExecStart=@ROOT@/.venv/bin/python -m skynet.telegram_bot --state @ROOT@/state/skynet.sqlite3 --service skynet.service
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
