[Unit]
Description=SkyNet bounded autonomous reactor
After=network-online.target
Wants=network-online.target
OnFailure=skynet-rollback.service
OnFailure=skynet-alert@%n.service
StartLimitIntervalSec=900
StartLimitBurst=5

[Service]
Type=simple
User=root
WorkingDirectory=@ROOT@
EnvironmentFile=@ROOT@/config/skynet.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=TZ=UTC
ExecStart=@ROOT@/.venv/bin/python -m skynet --interval 60
Restart=on-failure
RestartSec=10
TimeoutStopSec=1200
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
